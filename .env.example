# FlowEdge 配置文件
# 复制为 .env 并填入你的 API Key

# ========== 币安 API（主网，与 KKline 共用同一账户） ==========
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ========== 监控币种（逗号分隔） ==========
WATCH_SYMBOLS=BTCUSDT,ETHUSDT

# ========== 大单阈值（USDT） ==========
LARGE_TRADE_THRESHOLD=50000

# ========== VPIN 参数 ==========
VPIN_BUCKET_SIZE=100000
VPIN_NUM_BUCKETS=50

# ========== Coinglass API（付费 $29/月，不填则跳过） ==========
COINGLASS_API_KEY=

# ========== Coinalyze API（免费注册，不填则跳过） ==========
COINALYZE_API_KEY=

# ========== 南哥打法（高频 + 跟随做市商 + 判断方向，四层全做，参考 flowdege/参考/） ==========
NANGE_MODE=true

# ========== 高频模式（南哥打法建议同开） ==========
# 启用后：SSE 100ms、信号评估 300ms、数据同步 5s、REST 轮询 2 分钟、纸盘最低持仓 120s
HIGH_FREQ_MODE=true

# ========== 门卫 L3 行为层（南哥打法 = 四层全做，不跳过。仅临时“先开单”调试时设 true） ==========
GATE_SKIP_BEHAVIOR_LAYER=false

# ========== 放开/缩紧（默认缩紧版：提高胜率、减少低质量单；需放开时调小） ==========
# 纸盘：最低置信度、最低评分绝对值、开仓冷却秒、NEUTRAL+浮亏最短持仓秒
PAPER_MIN_CONFIDENCE=0.35
PAPER_MIN_ENTRY_SCORE=0.15
PAPER_COOLDOWN_S=45
PAPER_MIN_HOLD_WRONG_S=45
# 门卫：最低 |score|、最低置信度；30 分钟节点过滤（true 启用会减少开单）
GATE_MIN_SCORE=0.15
GATE_MIN_CONFIDENCE=0.35
GATE_TIME_FILTER_ENABLED=false

# ========== 优化总控 Agent（默认 Qwen，可切 deepseek/openai） ==========
# Provider: qwen / deepseek / openai
OPT_AGENT_PROVIDER=qwen
OPT_AGENT_MODEL=qwen-plus-latest
# Qwen（OpenAI 兼容）默认地址；切 deepseek/openai 时可覆盖
OPT_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 用于读取 API Key 的环境变量名（不要直接把明文 key 写在代码里）
OPT_AGENT_API_KEY_ENV=DASHSCOPE_API_KEY
