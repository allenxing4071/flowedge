# FlowEdge 配置文件
# 复制为 .env 并填入你的 API Key

# ========== 币安 API（主网，与 KKline 共用同一账户） ==========
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ========== 监控币种（逗号分隔） ==========
WATCH_SYMBOLS=BTCUSDT,ETHUSDT

# ========== 大单阈值（USDT） ==========
LARGE_TRADE_THRESHOLD=50000

# ========== VPIN 参数 ==========
VPIN_BUCKET_SIZE=100000
VPIN_NUM_BUCKETS=50

# ========== Coinglass API（付费 $29/月，不填则跳过） ==========
COINGLASS_API_KEY=

# ========== Coinalyze API（免费注册，不填则跳过） ==========
COINALYZE_API_KEY=
